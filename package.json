{
  "name": "sahaaya",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "prisma generate && node scripts/prepare-ocr.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "db:local": "tsx --env-file=.env scripts/local-db.ts",
    "db:pglite": "prisma dev --name sahaaya --port 51213",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@firebase/app": "^0.16.6",
    "@firebase/messaging": "^0.13.3",
    "@fontsource/manrope": "^5.3.0",
    "@google-cloud/storage": "^9.0.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@zxing/browser": "^0.2.1",
    "dotenv": "^18.0.10",
    "google-auth-library": "^10.5.0",
    "lucide-react": "^0.468.0",
    "luxon": "^3.7.2",
    "next": "16.4.6",
    "otpauth": "^9.6.0",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "svix": "^2.10.0",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "web-push": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-istanbul": "^5.1.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
