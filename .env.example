# npm run db:local initializes a native PostgreSQL server inside .data/postgres.
# Choose a unique local password before first initialization; keep it stable afterward.
DATABASE_URL="postgresql://postgres:change-me@127.0.0.1:54329/sahaaya"
APP_URL="http://127.0.0.1:3100"
DEMO_MODE="false"
# Set a persistent random 32-byte base64 key for encryption of OAuth tokens.
TOKEN_ENCRYPTION_KEY=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# Workload identity/ADC is preferred; otherwise an absolute service-account JSON path.
GOOGLE_APPLICATION_CREDENTIALS=""
GOOGLE_CLOUD_PROJECT=""
GOOGLE_VISION_ENABLED="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://127.0.0.1:3100/api/auth/google/callback"
GOOGLE_MAPS_API_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_WEB_API_KEY=""
FIREBASE_APP_ID=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_VAPID_KEY=""
RESEND_API_KEY=""
EMAIL_FROM="Sahaaya <care@example.com>"
# A private GCS bucket is required on Heroku; local files are for development only.
GCS_BUCKET=""
DB_POOL_SIZE="5"
EMERGENCY_NUMBER=""
WORKER_INTERVAL_MS="30000"

# Free Vercel + Neon + Cloudflare deployment. Never commit production values.
DIRECT_URL=""
STORAGE_PROVIDER="local"
WORKER_SECRET=""
WORKER_HEALTH_TIMEOUT_MS="900000"
REMINDER_CHECK_MINUTES="10"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
RESEND_WEBHOOK_SECRET=""
OPERATOR_EMAILS=""
# Keep false for the free Gemini tier when handling personal health information.
GEMINI_PRIVATE_DATA_ALLOWED="false"
